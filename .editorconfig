# SPDX-License-Identifier: Apache-2.0 OR MIT
# https://editorconfig.org: the whitespace rules `make format-check`
# enforces on Java and XML, applied by your editor everywhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[conformance/**]
# Vendored byte for byte from core; never reformatted here.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
