{
  // Markdown style for the docs-lint job. Length and inline HTML are not
  // linted (the README uses centred HTML headers); the rules that remain
  // catch real defects. conformance/ is vendored from core and linted
  // there.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD036": false,
    "MD040": false,
    "MD046": false,
    "MD049": false,
    "MD050": false
  },
  "ignores": [
    "node_modules/**",
    "target/**",
    "conformance/**",
    "CHANGELOG.md"
  ]
}
